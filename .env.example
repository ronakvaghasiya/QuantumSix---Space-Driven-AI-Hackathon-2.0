# Database
POSTGRES_USER=sdlc
POSTGRES_PASSWORD=sdlc_secret
POSTGRES_DB=sdlc_platform
DATABASE_URL=postgresql://sdlc:sdlc_secret@localhost:5432/sdlc_platform

# Backend
PORT=3001
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# GitLab (primary VCS)
GITLAB_BASE_URL=https://gitlab.com
# Optional — only needed for OAuth. PAT works without these.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_CALLBACK_URL=http://localhost:3001/api/v1/gitlab/callback
# Or set token here for server-side cloning (Settings UI PAT is preferred)
GITLAB_TOKEN=

# AI / Embeddings (use one provider — or configure both in Settings UI)
EMBEDDING_PROVIDER=huggingface
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
ANTHROPIC_API_KEY=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=repository_knowledge

# n8n
N8N_URL=http://localhost:5678
N8N_USER=admin
N8N_PASSWORD=admin123
N8N_WEBHOOK_BASE=http://localhost:5678/webhook

# Task pipeline: backend (default) | n8n | both
TASK_PIPELINE_MODE=backend

# Repository cloning
REPOS_BASE_PATH=/tmp/sdlc-repos
