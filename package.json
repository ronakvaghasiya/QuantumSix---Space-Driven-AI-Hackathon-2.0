{
  "name": "sdlc-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Autonomous SDLC Platform",
  "scripts": {
    "dev": "node scripts/kill-dev-ports.cjs && concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "npm run dev:infra && npm run dev",
    "dev:local": "node scripts/start-infra-local.cjs && npm run dev",
    "setup:local": "node scripts/setup-local.cjs",
    "start:local": "node scripts/start-local.cjs",
    "stop:local": "node scripts/stop-infra-local.cjs",
    "repair:qdrant": "node scripts/repair-qdrant.cjs",
    "dev:n8n": "node scripts/start-n8n-local.cjs",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:infra": "docker-compose up -d",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build:all": "cd backend && npm run build && cd ../frontend && npm run build",
    "screenshots": "node scripts/capture-screenshots.cjs",
    "ppt": ".venv-ppt/bin/python scripts/generate-ppt.py",
    "demo:video": ".venv-video/bin/python scripts/generate-demo-video.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
